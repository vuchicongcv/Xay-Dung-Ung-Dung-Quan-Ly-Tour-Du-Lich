# .htaccess
RewriteEngine On
RewriteBase /

# Ẩn .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Trang tĩnh
RewriteRule ^home$ index.php [L]
RewriteRule ^dat-tour$ booking.php [L]
RewriteRule ^goi-tour$ packages.php [L]
RewriteRule ^tim-tour$ packages.php [QSA,L]


# TOUR CHI TIẾT: /tour/slug
RewriteRule ^tour/([a-z0-9-]+)$ tour-detail.php?slug=$1 [L,QSA]

# 404
ErrorDocument 404 /404.php